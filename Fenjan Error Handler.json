      "name": "On Any Error"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst wf = e.workflow?.name || 'Unknown workflow';\nconst node = e.execution?.lastNodeExecuted || 'Unknown node';\nconst msg = String(e.execution?.error?.message || 'Unknown error').slice(0, 400);\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nreturn [{\n  json: {\n    timestamp: now,\n    workflow: wf,\n    node: node,\n    error: msg,\n    telegram_text: `⚠️ Error in ${wf}\\nNode: ${node}\\nReason: ${msg}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -128
      ],
      "id": "d97b2b45-b4fb-48ae-b05c-832462d06436",
